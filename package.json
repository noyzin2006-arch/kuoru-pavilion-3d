{
  "name": "kuoru-pavilion-3d",
  "version": "1.0.0",
  "private": true,
  "description": "颐和园廓如亭实时三维数字复原（KRT-001）—— 程序化生成，无外部素材",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-static.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test",
    "capture:visual": "node tools/capture-visual.mjs --dist dist --out reports/visual",
    "perf": "node tools/perf.mjs --dist dist --out reports/perf.json",
    "verify:geometry": "node tools/verify-geometry.mjs handoff/research/KRT-001-candidate-spec.json",
    "verify:contrast": "node tools/contrast.mjs --pairs tools/contrast-pairs.json"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
